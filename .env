# Copy to .env and fill in for real (non-mock) runs.

# --- GCP ---
GCP_PROJECT_ID=agripulse-506505
GCP_REGION=asia-south1
GCP_ZONE=asia-south1-a
BQ_DATASET=agripulse_data
RAW_BUCKET=agripulse-raw
PROCESSED_BUCKET=agripulse-processed

# --- Mode switch ---
# 1 = agents/backend read from local JSON fixtures, no GCP calls (default, good for local dev)
# 0 = agents/backend hit real BigQuery / Firestore
AGRIPULSE_MOCK_DATA=0

# --- Gemini ---
GEMINI_API_KEY=AQ.Ab8RN6JyYDsKSFd3KYhBsKh6meLjnYmtYnxzYRbYqrvufj2A9w
GEMINI_MODEL=gemini-3.6-flash

# --- Vertex AI ---
# Uses Application Default Credentials; no Gemini API key is needed.
VERTEX_AI_MODEL=gemini-2.5-flash

# --- data.gov.in (Agmarknet) ---
DATA_GOV_IN_API_KEY=579b464db66ec23bdd0000017508dd45ed79479d692b59f6750c4a8a

# --- CORS (comma-separated origins, or * for dev) ---
CORS_ORIGINS=*
