# Copy to .env and fill in for real (non-mock) runs.

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
BQ_DATASET=agripulse_data
RAW_BUCKET=agripulse-raw
PROCESSED_BUCKET=agripulse-processed

# --- Mode switch ---
# 1 = agents/backend read from local JSON fixtures, no GCP calls (default, good for local dev)
# 0 = agents/backend hit real BigQuery / Firestore
AGRIPULSE_MOCK_DATA=1

# --- Vertex AI ---
# Uses Application Default Credentials (ADC) - no API key needed
# Set GCP_PROJECT_ID and GCP_REGION above
VERTEX_AI_MODEL=gemini-2.0-flash
# Alternative models: gemini-1.5-pro, gemini-1.5-flash

# --- data.gov.in (Agmarknet) ---
DATA_GOV_IN_API_KEY=

# --- CORS (comma-separated origins, or * for dev) ---
CORS_ORIGINS=*
